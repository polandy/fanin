daemon:
  listen: 127.0.0.1:7420 # fanin.yaml:2
  store: <config>/fanin.db # fanin.yaml:3
  log:
    format: json # fanin.yaml:5
    level: info # fanin.yaml:6
  owner_token:
    env: FANIN_OWNER_TOKEN # fanin.yaml:7
    set: false # environment
project: alpha # projects/alpha.yaml
settings:
  path: /path/to/repo # projects/alpha.yaml:1
  host: local # projects/alpha.yaml:2
  forge: github # projects/alpha.yaml:3
  base: main # projects/alpha.yaml:4
  fallback: opencode # projects/alpha.yaml:5
  worker_kind: claude # default
  model: sonnet # projects/alpha.yaml:6
  review_skill: /pr-review # fanin.yaml:9
  review_model: sonnet # default
  review_timeout: 30m0s # default
  max_parallel: 2 # projects/alpha.yaml:7
  budgets:
    fix_rounds_per_run: 2 # projects/alpha.yaml:9
    rollover_pct: 75 # default
    max_tokens_per_run: 3000000 # default
    max_runs_per_task: 3 # fanin.yaml:11
  stall_after: 15m0s # default
  worker_timeout: 45m0s # default
  gate:
    github:
      watch_timeout: 30m0s # default
      settle: 20s # default
      max_waits: 12 # default
      max_watch_failures: 6 # default
    gitea:
      poll_interval: 1m0s # default
      noci_after_polls: 5 # default
      max_polls: 40 # default
  oc_merge: auto # default
  loop: bash # default
  post_merge_hook: /path/to/repo/scripts/deploy.sh # projects/alpha.yaml:10
host:
  name: local # built-in
  local: true # built-in
forge:
  name: github # projects/alpha.yaml:3
  kind: github # forges.yaml:4
  token:
    env: GH_TOKEN # forges.yaml:5
    set: false # environment
worker_kind:
  runtime: herdr # worker-kinds.yaml:3
  models: # worker-kinds.yaml:4
    - haiku
    - sonnet
    - opus
  default_model: sonnet # worker-kinds.yaml:5

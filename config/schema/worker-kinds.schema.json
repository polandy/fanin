{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-kinds.schema.json",
  "title": "worker-kinds.yaml",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kinds": {
      "type": "object",
      "propertyNames": {"$ref": "settings.schema.json#/$defs/name"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runtime"],
        "properties": {
          "runtime": {"description": "herdr runs a pane, headless a one-shot process", "enum": ["herdr", "headless"]},
          "models": {
            "description": "models the kind accepts; without it the kind takes no model (opencode: the sandbox fixes it)",
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "default_model": {"description": "model when neither owner, project nor picker names one", "type": "string", "minLength": 1}
        },
        "dependentRequired": {"default_model": ["models"]}
      }
    },
    "picker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "model"],
      "properties": {
        "kind": {"$ref": "settings.schema.json#/$defs/name"},
        "model": {"type": "string", "minLength": 1}
      }
    }
  }
}

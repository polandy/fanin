{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fanin.schema.json",
  "title": "fanin.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["listen", "store", "owner_token_env"],
  "properties": {
    "listen": {"description": "host:port of the HTTP API", "type": "string", "minLength": 1},
    "store": {"description": "SQLite file; a relative path is taken from the config directory", "type": "string", "minLength": 1},
    "log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {"enum": ["json", "text"], "default": "json"},
        "level": {"enum": ["debug", "info", "warn", "error"], "default": "info"}
      }
    },
    "notify": {
      "description": "the push channel for owner notes",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["log", "signal"], "default": "log"},
        "ui_url": {"description": "base URL of the web UI; notes link to <ui_url>/#/task/<id>", "type": "string", "format": "uri", "minLength": 1},
        "prefix": {"description": "starts every note; default [<host>/fanin]", "type": "string", "minLength": 1},
        "signal_number": {"description": "the owner's own number: signal-cli account and only recipient", "type": "string", "pattern": "^\\+[0-9]{6,15}$"},
        "signal_cli": {"description": "the signal-cli program", "type": "string", "minLength": 1, "default": "signal-cli"}
      },
      "if": {"properties": {"kind": {"const": "signal"}}, "required": ["kind"]},
      "then": {"required": ["signal_number", "ui_url"]}
    },
    "owner_token_env": {"description": "environment variable that holds the owner token", "$ref": "secret.schema.json"},
    "defaults": {
      "description": "project settings every project file may override",
      "$ref": "settings.schema.json#/$defs/settings",
      "unevaluatedProperties": false
    }
  }
}
